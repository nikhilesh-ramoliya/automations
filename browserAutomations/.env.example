# Browser automations — copy to .env (never commit .env)
# Jobs: npm run jobs:list | npm run jobs:run -- <jobId> [--dry-run]

# LinkedIn credentials
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password-here

# Optional aliases (also supported by the login script)
# EMAIL=your-email@example.com
# PASSWORD=your-password-here

# Google / Gmail session (npm run auth:google) — separate profile from LinkedIn
# Used by lead-send-outreach to email leads when person.email is known.
# Prefer headed; complete 2FA in the browser. No password required in .env.
# GOOGLE_USE_CHROME=true

# Set to "true" to run headless (increases LinkedIn detection risk — prefer headed)
# HEADLESS=false

# --- LinkedIn safety (risk reduction — does NOT guarantee no restrictions) ---
# Daily caps for an established account (mid of recommended ranges).
# Connects/messages stay much lower than searches & profile views.
# LI_SAFE_MAX_SEARCHES_PER_DAY=70
# LI_SAFE_MAX_PROFILE_VIEWS_PER_DAY=180
# LI_SAFE_MAX_PAGE_VIEWS_PER_DAY=250
# LI_SAFE_MAX_CONNECTS_PER_DAY=20
# LI_SAFE_MAX_MESSAGES_PER_DAY=20
# LI_SAFE_MAX_INVITES_PER_DAY=20
# LI_SAFE_MAX_REACTIONS_PER_DAY=40
# Active browsing minutes per job (burst pauses excluded). Default 60.
# LI_SAFE_MAX_JOB_RUNTIME_MIN=60
# After every 15–25 actions, pause 5–20 minutes (spreads activity).
# LI_SAFE_BURST_ACTIONS_LO=15
# LI_SAFE_BURST_ACTIONS_HI=25
# LI_SAFE_BURST_PAUSE_MIN_LO=5
# LI_SAFE_BURST_PAUSE_MIN_HI=20
# LI_SAFE_BURST_PAUSE=true
# Slow everything further if challenged recently (1.5–2)
# LI_SAFE_DELAY_MULT=1.0
# Operation delays: ~3–15s between actions; ~20–60s on profiles; human scroll.
# Optional browser locale / timezone / Accept-Language
# LI_SAFE_LOCALE=en-US
# LI_SAFE_TIMEZONE=America/New_York
# LI_SAFE_ACCEPT_LANGUAGE=en-US,en;q=0.9

# --- Invite connections to follow Lanatus Page ---
# Verified default: https://www.linkedin.com/company/lanatus/
LANATUS_COMPANY_URL=https://www.linkedin.com/company/lanatus/
# LINKEDIN_COMPANY_URL=https://www.linkedin.com/company/lanatus/

# Monthly pacing (default): batch = ceil(remainingCredits / remainingDays)
# remainingDays = lastDayOfMonth - today + 1 (includes today).
# INVITE_MAX is an optional CAP on that batch (not a fixed quota).
# Final batch = min(paced, INVITE_MAX, remaining daily LI_SAFE invite cap).
# INVITE_MAX=20
# INVITE_MAX_MODE=cap
# Use override only if you want INVITE_MAX to replace the paced size:
# INVITE_MAX_MODE=override

# Floor for human-like delays between UI actions (ms); actual pauses are randomized per op
INVITE_DELAY_MS=2000

# true = open modal + log who would be invited; do not click Invite (recommended default)
INVITE_DRY_RUN=true

# Optional: filter connections in the invite modal search box
# INVITE_QUERY=

# Optional: comma-separated ranking keywords (defaults tuned for Lanatus)
# INVITE_PRIORITY_KEYWORDS=founder,CEO,CTO,VP,Director,Head of,automation,software,SaaS

# --- Optional recording extras ---
# RECORD_START_URLS=https://www.linkedin.com/company/lanatus/
# RECORDING_PATH=logs/recording-YYYYMMDD-HHMMSS.jsonl

# --- Lead generation (data/leads/<runId>/ → output/leads/<runId>/) ---
# Company research is web-first (public site), LinkedIn secondary/supplement.
# LEAD_RUN_ID=
# LEAD_DRY_RUN=true
# LEAD_MAX_COMPANIES=10
# LEAD_MAX_PEOPLE_PER_COMPANY=3
# Fake seed companies/people — OFF by default. Discover fails clearly if LinkedIn
# returns 0 results. Set true only for local smoke tests (never for live outreach).
LEAD_ALLOW_SEEDS=false
# Lead person/company outreach score floor (qualify + export)
# LEAD_MIN_SCORE=60
# Company ICP gate (discover / enrich / qualify). Default ~50.
# LEAD_MIN_COMPANY_SCORE=50
# ICP search + scoring defaults (Lanatus: IT consulting / custom software / automation / cloud)
LEAD_KEYWORDS=software,automation,digital transformation,IT consulting,cloud,custom software,ERP,legacy modernization
LEAD_GEOS=United States
LEAD_INDUSTRIES=Manufacturing,Logistics,Healthcare,Financial Services,Professional Services,Insurance,Construction,Energy,Retail,Education,Transportation,Wholesale
# LEAD_DELAY_MS=2000
# Prefer public website before LinkedIn enrich (default true)
# LEAD_ENRICH_WEB_FIRST=true
# Also pull LinkedIn company page as supplement (employee count/tagline). false = web only (safer)
# LEAD_ENRICH_LINKEDIN=true
# When full LI enrich is off, still open company About to read website URL only (default true)
# LEAD_ENRICH_LINKEDIN_WEBSITE=true
# Drop companies without a website at enrich gate (default false — keep strong ICP with low confidence)
# LEAD_REQUIRE_WEBSITE=false
# Cap web searches per run when search is enabled (default 10)
# LEAD_MAX_WEB_SEARCHES=10
#
# DEFAULT: skip all web search (API + HTML). LinkedIn About → website → crawl.
# LEAD_SKIP_WEB_SEARCH=true
# LEAD_HTML_SEARCH=false
# LEAD_PEOPLE_WEB_SEARCH=false
#
# Optional paid APIs — only used when LEAD_SKIP_WEB_SEARCH=false:
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_API_KEY=
# AZURE_BING_SEARCH_KEY=
# LEAD_SEARCH_PROVIDER=auto
#
# Prefer installed Google Chrome for ephemeral web browsers (not LinkedIn). Default true.
# LEAD_WEB_USE_SYSTEM_CHROME=true
# Extra HTML SERP delay multiplier (only if HTML search on). Default 1.5.
# LEAD_WEB_DELAY_MULT=1.5
# Tech-signals: max pages per company site crawl (default 8)
# LEAD_TECH_CRAWL_MAX_PAGES=8
# People: website leadership → company People local search (no global LI search by default)
# LEAD_PEOPLE_WEB_FIRST=true
# LEAD_PEOPLE_LINKEDIN_COMPANY=true
# Global LinkedIn people search (default false — use company page People tab)
LEAD_PEOPLE_LINKEDIN_SEARCH=false
# Site-visit parallelism only (never LinkedIn). Default 1; max 2.
# LEAD_WEB_CONCURRENCY=1
#
# Optional pipeline slice:
# LEAD_PIPELINE_FROM=lead-discover-companies
# LEAD_PIPELINE_TO=lead-export
#
# Send outreach (after draft+export review) — NOT in default pipeline:
# npm run auth:google
# npm run jobs:run -- lead-send-outreach --dry-run
# LEAD_SEND_MAX=10
# LEAD_SEND_ADD_NOTE=true
#
# Follow up after accepted connects (short LI DM) — NOT in default pipeline:
# npm run jobs:run -- lead-followup-accepted --dry-run
# LEAD_FOLLOWUP_MAX=10
# LEAD_FOLLOWUP_ONLY_ACCEPTED=false
#
# Suppress lists (CSV/JSON); defaults to data/leads/suppress/*.example.csv
# LEAD_SUPPRESS_COMPANIES=data/leads/suppress/companies.example.csv
# LEAD_SUPPRESS_PEOPLE=data/leads/suppress/people.example.csv
# Offer labels (or LEAD_OFFERS_JSON='{"custom_software":"..."}'):
# LEAD_OFFER_CUSTOM_SOFTWARE=Custom software development
# LEAD_OFFER_AUTOMATION_RPA=Automation / RPA
# LEAD_OFFER_CLOUD_DEVOPS=Cloud / DevOps
# LEAD_OFFER_PRODUCT_ENGINEERING=Product engineering
# LEAD_OFFER_IT_CONSULTING=IT consulting

# --- Visibility / personal LinkedIn brand (data/visibility/<runId>/) ---
# Content-first: search posts → like/comment. Connect ONLY if software-dev lead-fit is high.
# VISIBILITY_TARGETED=false
# VISIBILITY_RUN_ID=
# VISIBILITY_DRY_RUN=true
# VISIBILITY_KEYWORDS=AI,GenAI,automation,IT consulting,custom software,software engineering,digital transformation,RPA
# VISIBILITY_RANDOM_SEARCH=true
# VISIBILITY_MAX_POSTS=15
# VISIBILITY_MAX_REACTIONS=6
# VISIBILITY_MAX_COMMENTS=4
# VISIBILITY_MAX_CONNECTS=2
# VISIBILITY_CONNECT_MIN_LEAD_SCORE=80
# VISIBILITY_DO_REACT=true
# VISIBILITY_DO_COMMENT=true
# VISIBILITY_DO_CONNECT=true
# VISIBILITY_LIKE_MIN_SCORE=55
# VISIBILITY_COMMENT_MIN_SCORE=75
# VISIBILITY_MAX_SCAN=25
# VISIBILITY_MAX_DRAFTS=5
# VISIBILITY_DELAY_MS=2000
# Optional ICP people mode (not default):
# VISIBILITY_TARGETED=true
# VISIBILITY_ICP_QUERIES=CTO software,Founder SaaS,VP Engineering
# VISIBILITY_MAX_PROFILES=12
# Optional pipeline slice:
# VISIBILITY_PIPELINE_FROM=visibility-find-posts
# VISIBILITY_PIPELINE_TO=visibility-draft-posts

# --- LinkedIn content engine (offline drafts; data/content/<runId>/) ---
# research topics → generate & score posts (never publishes)
# CONTENT_RUN_ID=
# CONTENT_DRY_RUN=true
# CONTENT_MAX_TOPICS=8
# CONTENT_MAX_VARIATIONS=4
# CONTENT_MIN_SCORE=55
# CONTENT_USE_AI=true
# CONTENT_BRAND_NAME=Lanatus
# Editable rules (Interests / Must / Never): data/content/instructions.md
# Interest usage (auto): data/content/interest-usage.json
# CONTENT_INSTRUCTIONS_PATH=data/content/instructions.md
# CONTENT_CATEGORIES=AI,Software Engineering,Startups,SaaS,Automation,Playwright,Testing,Cloud,DevOps,Product Development,Engineering Leadership,Scaling Teams,MVP Development,Case Studies,Performance,Architecture
# CONTENT_AUDIENCES=Startup founders,CTOs,Engineering Managers,Product Leaders,Companies looking to outsource software development,Companies interested in AI automation
# Preferred generator: Cursor CLI (`agent -p --mode ask`)
# CURSOR_API_KEY=
# CONTENT_CURSOR_MODEL=composer-2.5
# CONTENT_CURSOR_CLI=   # optional path to agent.cmd if not on PATH
# CONTENT_CURSOR_TIMEOUT_MS=180000
# CONTENT_CURSOR_RETRIES=4
# CONTENT_CURSOR_RETRY_MS=8000
# Optional OpenAI-compatible fallback:
# OPENAI_API_KEY=
# CONTENT_AI_API_KEY=
# CONTENT_AI_BASE_URL=https://api.openai.com/v1
# CONTENT_AI_MODEL=gpt-4o-mini
# Optional pipeline slice:
# CONTENT_PIPELINE_FROM=content-research-topics
# CONTENT_PIPELINE_TO=content-generate-posts
# Compose into LinkedIn share box (Post not clicked unless CONTENT_DO_PUBLISH=true + --no-dry-run):
# CONTENT_COMPOSE_REVIEW_MS=12000
# CONTENT_COMPOSE_DRAFT_ID=
# CONTENT_DO_PUBLISH=false
# Generate a 1200×627 title card and attach it (set false to post text-only):
# CONTENT_ATTACH_IMAGE=true
# Design card copy from ## Image in data/content/instructions.md (Cursor/AI):
# CONTENT_IMAGE_AI=true
# Card byline / style (overrides ## Image keyed fields):
# CONTENT_IMAGE_NAME=Your Name
# CONTENT_IMAGE_ROLE=Engineering
# CONTENT_IMAGE_HANDLE=
# CONTENT_IMAGE_STYLE=dark editorial
# CONTENT_IMAGE_PALETTE=navy and ice blue
# CONTENT_IMAGE_LAYOUT=title
# CONTENT_IMAGE_HEADLINE=
# Or attach a specific file instead of the generated card:
# CONTENT_IMAGE_PATH=
