<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <style>
    table,
    th,
    td {
      border: solid black;
      border-collapse: collapse;
      padding: 5px;
    }
    th {
      background-color: #94e7f2;
    }
    .paddingtop {
      padding-top: 20px;
    }
    .wideheader {
      height: 50px;
    }
    .wideheader1 {
      height: 30px;
    }
    .text1 {
      font-size: 23px;
    }
    .text2 {
      font-size: 15px;
    }
    .bottomright {
      text-align: right;
      font-weight: bold;
    }
    body {
      display: flex;
      justify-content: center;
    }
    .bold {
      font-weight: bold;
    }
    .center {
      text-align: center;
    }
    .reportcontainer {
      position: relative;
      width: 100%;
    }
    .logocontainer {
      position: absolute;
      right: 3px;
      top: 3px;
    }
    .right {
      text-align: center;
    }
  </style>

  <body>
    <div class="reportcontainer">
      <div class="logocontainer">
        <img
          src="data:image/png;base64,"
          alt="lanatus systems"
        />
      </div>
      <table width="100%">
        <tr class="wideheader">
          <th colspan="4" class="text1">Lanatus Systems LLP</th>
        </tr>
        <tr class="wideheader1">
          <th colspan="4" class="text2">CTC SALARY STRUCTURE</th>
        </tr>
        <tr>
          <td class="bold">Name of employees</td>
          <td colspan="3">{{Name}}</td>
        </tr>
        <tr>
          <td class="bold">Designation</td>
          <td colspan="3">{{Designation}}</td>
        </tr>
        <tr>
          <td class="bold">Date of Joining</td>
          <td colspan="3">{{Date_Of_Joining}}</td>
        </tr>
        <tr>
          <td class="bold">Bank Account Number</td>
          <td colspan="3">{{Bank_Account_Number}}</td>
        </tr>
        <tr>
          <td rowspan="2" class="bold">Leave Balance</td>
          <td class="bold center">Total leave</td>
          <td class="bold center">Leave taken</td>
          <td class="bold center">Available Balance</td>
        </tr>
        <tr class="right">
          <td>{{Total_Leave}}</td>
          <td>{{Leave_Taken}}</td>
          <td>{{Available_Balance}}</td>
        </tr>
        <tr>
          <td class="bold">Location</td>
          <td colspan="3">{{Location}}</td>
        </tr>
        <tr>
          <td class="bold">Payslip for the month</td>
          <td colspan="3">{{Payslip_For_The_Month}}</td>
        </tr>
        <tr>
          <td colspan="4" class="paddingtop bold center">
            Salary Structure w.e.f &nbsp;&nbsp;01.01.2022
          </td>
        </tr>
        <tr>
          <th>Bifurcation</th>
          <th>Monthly(Rs.)</th>
          <th colspan="2">Deductions</th>
        </tr>
        <tr>
          <td colspan="2">&nbsp;</td>
        </tr>
        <tr>
          <th>Earnings</th>
          <th>Amount</th>
          <th>Particulars</th>
          <th>Amount</th>
        </tr>
        <tr>
          <td>Basic Salary</td>
          <td class="right">{{Basic_Salary}}</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
        </tr>
        <tr>
          <td>HRA</td>
          <td class="right">{{HRA}}</td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td>Other Allowances</td>
          <td class="right">{{Other_Allowances}}</td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <th>Total Earnings --(A)</th>
          <th>{{Total_Earnings}}</th>
          <th></th>
          <th></th>
        </tr>
        <tr>
          <td colspan="4" class="paddingtop bottomright">Head-HR</td>
        </tr>
      </table>
    </div>
  </body>
</html>
