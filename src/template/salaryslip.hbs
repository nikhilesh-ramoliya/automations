<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payslip</title>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap");
  </style>

  <style>
    :root {
      --background-color: #f2f2f2;
      --primary-text-color: #333333;
      --border-color: #cccccc;
    }

    body {
      font-family: "Poppins", sans-serif;
      font-weight: 500;
      font-style: normal;
      margin: 0;
      display: flex;
      background: white;
      color: var(--primary-text-color);
    }

    .payslip-container {
      max-width: 800px;
      margin: auto;
      flex: 1;
      background: white;
      height: 100%;
      padding: 50px;

    }

    .header,
    .salary-details,
    .leave-details {
      margin-bottom: 20px;
    }

    .header h1,
    .header h2 {
      margin: 0;
    }

    .header h1 {
      font-size: 30px;
      font-weight: bold;
    }

    .header img {
      float: right;
    }

    .company-info,
    .employee-info {
      font-size: 14px;
    }

    .salary-table {
      width: 100%;
      line-height: 1;
    }

    .salary-table th,
    .salary-table td {
      border: none;
      padding: 5px;
      text-align: left;
      font-size: 14px;
    }

    .section-title {
      font-weight: bold;
      font-size: 20px;
      margin-bottom: 10px;
      color: #333;
      margin-top: 50px;
    }

    .summary {
      background-color: #f9f9f9;
      font-weight: bold;
      text-align: center;
    }

    .footer-note {
      font-size: 12px;
      color: #555;
      text-align: center;
    }

    .note {
      font-weight: bold;
    }

    .center {
      text-align: center;
    }

    .font-size {
      font-size: small;
      font-weight: 100;
      font-family: monospace;
    }

    h1 span {
      font-weight: normal;
    }
  </style>
</head>

<body>
  <div class="payslip-container">
    <!-- Header Section -->
    <header class="header">
      <h1>PAYSLIP <span>{{Payslip_For_The_Month}}</span></h1>
      <img src="https://www.lanatussystems.com/_next/image?url=%2Fimages%2FlanatusLogo%2Flogo.png&w=256&q=75"
        alt="Lanatus System Logo" />
      <p style="margin-top: 20px">LANATUS SYSTEMS LLP</p>
      <p style="font-size: smaller">
        1107, Shivalik Shilp II, Opp. ITC Narmada Hotel, Vastrapur,<br />
        Ahmedabad, Gujarat 380015<br />
      </p>
    </header>

    <!-- Employee Details Section -->
    <section class="employee-info">
      <section class="section-title">EMPLOYEE DETAILS</section>
      <hr />
      <table class="salary-table">
        <tr>
          <th>Employee Name</th>
          <td>{{Name}}</td>
          <th>Bank Account No</th>
          <td>{{Bank_Account_Number}}</td>
        </tr>
        <tr>
          <th>Designation</th>
          <td>{{Designation}}</td>
          <th>PAN</th>
          <td>{{Pan_Card_Number}}</td>
        </tr>
        <tr>
          <th>Date Of Joining</th>
          <td>{{Date_Of_Joining}}</td>
          <th>Location</th>
          <td>{{Location}}</td>
        </tr>
      </table>
    </section>

    <!-- Salary Details Section -->
    <section class="salary-details">
      <section class="section-title">SALARY DETAILS</section>
      <hr />
      <table class="salary-table">
        <tr>
          <td class="font-weight-bold">Month & Year :</td>
          <td class="font-weight-bold" colspan="2">{{Payslip_For_The_Month }}</td>
        </tr>
        <tr>
          <th>Total Leaves</th>
          <th>Leaves Taken</th>
          <th>Leaves for Month</th>
          <th>Available Leaves</th>
        </tr>
        <tr>
          <td>{{Total_Leave}}</td>
          <td>{{Leave_Taken}}</td>
          <td>{{Leave_Taken_In_Month}}</td>
          <td>{{Available_Balance}}</td>
        </tr>
      </table>
      <br />

      <hr />
      <table class="salary-table">
        <thead>
          <tr>
            <th scope="col">Earnings</th>
            <th scope="col">Amount</th>
            <th scope="col">Taxes & Deductions</th>
            <th scope="col">Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Basic</td>
            <td>{{Basic_DA}}</td>
            <td>Leaves</td>
            <td>{{Leaves}}</td>
          </tr>
        </tbody>
        <tr>
          <td>HRA</td>
          <td>{{HRA }}</td>
          <td>Provident Fund</td>
          <td>{{Provident_Fund}}</td>
        </tr>
        <tr>
          <td>Other Allowance</td>
          <td>{{Other_Allowances }}</td>
          <td>Professional Tax</td>
          <td>{{Professional_Tax}}</td>
        </tr>
        <tr>
          <td>Conveyance Allowance</td>
          <td>{{Conveyance}}</td>
          <td>TDS/IT</td>
          <td>{{TDS_IT}}</td>
        </tr>
        <tr>
          <td>Special Allowance</td>
          <td>{{Special_Allowances}}</td>
          <td colspan="2"></td>
        </tr>
        <tr>
          <td>Fixed Bonus</td>
          <td>{{Fixed_Bonus}}</td>
          <td colspan="2"></td>
        </tr>
        <tr>
          <td>Perfor. Bonus</td>
          <td>{{Performance_Bonus}}</td>
        </tr>
        <tfoot>
          <tr class="summary">
            <td>Total Earnings</td>
            <td>{{Total_Addition}}</td>
            <td>Total Deductions</td>
            <td>{{Total_Deductions}}</td>
          </tr>
        </tfoot>
      </table>

      <hr />

      <p>
        Net Salary Payable
        <strong style="margin-left: 40px">{{Net_Salary}}</strong>
      </p>

      <p>
        Net Salary in words:
        <strong style="margin-left: 34px">{{Net_salary_in_words}}</strong>
      </p>
      <p style="margin-left: 10px">
        <small class="note">**Note: </small>All amounts displayed in this
        payslip are in <small class="note">INR</small>
      </p>
      <p class="font-size">
        {{Payment_Mode}} Through {{From_Bank_Name}} Bank
      </p>
      <p class="font-size">Dated : {{Payment_Date}}</p>
    </section>
    <!-- Footer Note -->
    <footer class="footer-note">
      This is a system generated salary slip and does not require signature.
    </footer>
  </div>
</body>

</html>