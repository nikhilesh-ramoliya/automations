<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      body {
        font-family: system-ui, system-ui, sans-serif;
        font-size: 81.25%;
      }

      table,
      th,
      td {
        border: 1px solid black;
        border-collapse: collapse;
      }
      .maindiv {
        width: 100%;
        display: flex;
        justify-content: center;
      }
      /* .logocontainer {
      } */
      .signHR {
        height: 2.3rem;
      }
      .hrsign {
        position: absolute;
        left: 28rem;
        border: none;
      }
      .comapanyname {
        background-color: rgb(207, 226, 243);
        height: 2.7rem;
        font-size: large;
      }
      .Address {
        text-align: center;
      }
      .employeeDetail {
        background-color: rgb(207, 226, 243);
      }
      .SalaryStructure {
        background-color: rgb(207, 226, 243);
      }
      .Earnings {
        background-color: rgb(207, 226, 243);
      }
      .TotalAddition {
        background-color: rgb(207, 226, 243);
      }
      .netSalary {
        background-color: rgb(207, 226, 243);
        font-weight: bolder;
      }
      .employeeName {
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="maindiv">
      <table style="width: 90%">
        <tr class="header">
          <th colspan="4" class="comapanyname">
            <div
              style="
                width: 100%;
                height: 70px;
                position: relative;
                display: flex;
                justify-content: center;
                align-items: center;
              "
            >
              Lanatus Systems LLP
              <img
                style="position: absolute; right: 0; height: 66px"
                src="data:image/png;base64,"
                alt="lanatus systems"
              />
            </div>
          </th>
        </tr>
        <tr class="Address">
          <td colspan="4">
            [627, Iscon Emporio, Pandurang Shashtri Marg, Satellite, Ahmedabad,
            Gujarat 380015]
          </td>
        </tr>
        <tr>
          <th colspan="4">PAN : [AAKFL0145M]</th>
        </tr>
        <tr>
          <th colspan="4" class="employeeDetail">Employee Details</th>
        </tr>
        <tr>
          <td class="employeeName">Name of the Employee :</td>
          <td colspan="3" width="250rem" class="employeeName">{{Name}}</td>
        </tr>
        <tr>
          <td class="employeeName">Designation :</td>
          <td colspan="3">{{Designation}}</td>
        </tr>
        <tr>
          <td class="employeeName">Date of Joining:</td>
          <td colspan="3">{{Date_Of_Joining}}</td>
        </tr>
        <tr>
          <td class="employeeName">Bank Account Number :</td>
          <td colspan="3">{{Bank_Account_Number}}</td>
        </tr>
        <tr>
          <td class="employeeName">Location :</td>
          <td colspan="3">{{Location}}</td>
        </tr>
        <tr>
          <td class="employeeName">PAN :</td>
          <td colspan="3">{{Pan_Card_Number}}</td>
        </tr>
        <tr>
          <th colspan="4" class="SalaryStructure">
            Salary Structure w.e.f. 01.01.2022
          </th>
        </tr>
        <tr>
          <td class="employeeName">Month & Year :</td>
          <td colspan="3">{{Payslip_For_The_Month }}</td>
        </tr>

        <tr>
          <td rowspan="2" class="employeeName">Leave Balance:</td>
          <td class="employeeName">Total Leave</td>
          <td class="employeeName">Leave Taken</td>
          <td class="employeeName">Available Balance</td>
        </tr>
        <tr>
          <td>{{Total_Leave}}</td>
          <td>{{Leave_Taken}}</td>
          <td>{{Available_Balance }}</td>
        </tr>
        <tr class="Earnings">
          <td class="employeeName">Earnings</td>
          <td></td>
          <td class="employeeName">Deductions</td>
          <td></td>
        </tr>
        <tr>
          <td>Basic & DA</td>
          <td>{{Basic_DA}}</td>
          <td>Leaves</td>
          <td>{{Leaves}}</td>
        </tr>
        <tr>
          <td>HRA</td>
          <td>{{HRA }}</td>
          <td>Provident Fund</td>
          <td>{{Provident_Fund}}</td>
        </tr>
        <tr>
          <td>Other Allow.</td>
          <td>{{Other_Allowances }}</td>
          <td>Professional Tax</td>
          <td>{{Professional_Tax}}</td>
        </tr>
        <tr>
          <td>Conveyance</td>
          <td>{{Conveyance}}</td>
          <td>TDS/IT</td>
          <td>{{TDS_IT}}</td>
        </tr>
        <tr>
          <td>Special Allow.</td>
          <td>{{Special_Allowances}}</td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td>Fixed Bonus</td>
          <td>{{Fixed_Bonus}}</td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td>Perfor. Bonus</td>
          <td>{{Performance_Bonus}}</td>
          <td></td>
          <td></td>
        </tr>
        <tr class="TotalAddition">
          <td class="employeeName">Total Addition</td>
          <td>{{Total_Addition}}</td>
          <td class="employeeName">Total Deductions</td>
          <td>{{Total_Deductions}}</td>
        </tr>
        <tr>
          <td></td>
          <td></td>
          <td class="netSalary">NET SALARY</td>
          <td class="netSalary">{{Net_Salary}}</td>
        </tr>
        <tr>
          <td></td>
          <td></td>
          <td>&nbsp;</td>
          <td></td>
        </tr>
        <tr>
          <td
            colspan="4"
            class="employeeName"
            style="text-transform: capitalize"
          >
            INR : {{net_salary_in_words}}
          </td>
        </tr>
        <tr>
          <td colspan="4" class="employeeName">
            {{Payment_Mode}} Through {{From_Bank_Name}} Bank
          </td>
        </tr>
        <tr>
          <td colspan="4" class="employeeName">Dated : {{Payment_Date}}</td>
        </tr>
        <tr>
          <td></td>
          <td></td>
          <th colspan="2">For [Lanatus Systems]</th>
        </tr>

        <tr class="signHR">
          <td></td>

          <td>
            <img
              style="height: 30px"
              src="data:image/jpeg;base64,"
            />
          </td>
          <td colspan="2"></td>
        </tr>

        <tr>
          <td colspan="2" class="employeeName">SIGNATURE OF THE EMPLOYEE</td>
          <th colspan="2">Authorised Signatory</th>
        </tr>
      </table>
    </div>
  </body>
</html>
